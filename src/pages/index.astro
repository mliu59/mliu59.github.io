---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import PostCard from "@components/PostCard.astro";
import ProjectCarousel from "@components/ProjectCarousel.astro";
import { Button } from "@/components/starwind/button";
import { ItemGroup, ItemSeparator } from "@/components/starwind/item";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import { HOME, SITE } from "@consts";
import portrait from "../assets/ML.jpg";

const latestPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const featuredProjects = (await getCollection("projects"))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="flex flex-col gap-6 md:flex-row md:items-start">
      <article class="min-w-0 flex-1 space-y-4">
        <h4 class="animate font-semibold text-foreground">
          Hi, I'm Miles <span class="text-xl"></span>
        </h4>
        <p class="animate">
          I'm a generalist software and robotics engineer with AI/ML applications experience. Most recently a Systems Engineer on the Advanced Product Development team at
          <Link href="https://www.intuitive.com/en-us" external>Intuitive Surgical</Link>
        </p>
        <p class="animate">
          I graduated from Johns Hopkins University with an M.S.E. in Robotics
          (focus in Medical Robotics, 2022) and a B.S. in Mechanical Engineering
          (2021), where I worked as a Graduate Research Assistant at the
          <Link href="https://ciis.lcsr.jhu.edu/doku.php" external>
            Computer Integrated Interventional Systems (CIIS) Laboratory
          </Link>
        </p>
      </article>
      <Image
        src={portrait}
        alt="Miles Liu"
        width={220}
        class="animate mx-auto w-[220px] shrink-0 rounded-sm md:mx-0"
      />
    </section>

    <section class="mt-12">
      <h4 class="animate font-semibold text-foreground">
        GitHub:
        <Link href="https://github.com/mliu59" external>mliu59</Link>
      </h4>
      <a
        href="https://github.com/mliu59"
        target="_blank"
        rel="noopener noreferrer"
        class="animate mt-4 block"
      >
        <img
          src="https://ghchart.rshah.org/3C6E71/mliu59"
          alt="Miles Liu's GitHub contribution graph"
          loading="lazy"
          class="w-full dark:invert dark:hue-rotate-180"
        />
      </a>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="mt-24">
          <div class="animate flex items-center justify-between">
            <h4 class="font-semibold text-foreground">
              Projects
            </h4>
            <Button href="/projects" variant="ghost" size="sm" class="text-primary-accent">
              All projects
              <ArrowRight aria-hidden="true" />
            </Button>
          </div>
          <div class="animate mt-4">
            <ProjectCarousel projects={featuredProjects} />
          </div>
        </section>
      )
    }

    {
      latestPosts.length > 0 && (
        <section class="mt-24">
          <div class="animate flex items-center justify-between">
            <h4 class="font-semibold text-foreground">
              Latest blog posts
            </h4>
            <Button href="/blog" variant="ghost" size="sm" class="text-primary-accent">
              All posts
              <ArrowRight aria-hidden="true" />
            </Button>
          </div>
          <ItemGroup class="animate mt-4">
            {latestPosts.map((post, i) => (
              <>
                {i > 0 && <ItemSeparator />}
                <PostCard post={post} />
              </>
            ))}
          </ItemGroup>
        </section>
      )
    }
  </Container>
</PageLayout>
