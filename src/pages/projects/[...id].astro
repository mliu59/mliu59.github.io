---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { projectPath, isExternalHref } from "@lib/utils";

// Detail pages are generated only for projects without an explicit `link`;
// linked projects send visitors straight to that link instead.
export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (p) => !p.data.draft && !p.data.link
  );
  return projects.map((project) => ({
    params: { id: projectPath(project.id).replace(/^\/projects\//, "") },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const { Content } = await render(project);
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="animate text-sm opacity-70">
      <Link href="/projects" underline={false}>&larr; All projects</Link>
    </div>

    <article class="mt-6">
      <header class="animate not-prose mb-8">
        <h1 class="text-3xl md:text-4xl font-semibold text-[#353535] dark:text-[#FFFFFF]">
          {project.data.title}
        </h1>
        <p class="mt-2 opacity-80">{project.data.description}</p>
        {
          project.data.links.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {project.data.links.map((l) => (
                <Link href={l.href} external={isExternalHref(l.href)}>
                  <span class="text-[#3C6E71] dark:text-[#9bbfc1]">{l.label}</span>
                  {isExternalHref(l.href) && <span aria-hidden="true"> &#8599;</span>}
                </Link>
              ))}
            </div>
          )
        }
      </header>

      <Image
        src={project.data.thumbnail}
        alt={project.data.thumbnailAlt ?? project.data.title}
        class="animate mb-8 rounded-lg w-full"
      />

      <div class="animate">
        <Content />
      </div>
    </article>

    <div class="animate mt-12 text-sm opacity-70">
      <Link href="/projects" underline={false}>&larr; All projects</Link>
    </div>
  </Container>
</PageLayout>
