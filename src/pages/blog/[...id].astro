---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { Prose } from "@/components/starwind/prose";
import { Badge } from "@/components/starwind/badge";
import { Separator } from "@/components/starwind/separator";
import { SITE } from "@consts";
import { postPath } from "@lib/utils";
import { getProject } from "@lib/projects";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { id: postPath(post.id).replace(/^\/blog\//, "") },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };

const { post } = Astro.props;
const { Content } = await render(post);
const project = getProject(post.id);
---

<PageLayout title={post.data.title} description={`${post.data.title}, a ${project.name} post by ${SITE.NAME}.`}>
  <Container>
    <div class="animate text-sm text-muted-foreground">
      <Link href="/blog" underline={false}>&larr; All posts</Link>
    </div>

    <article class="mt-6">
      <header class="animate mb-8">
        <h1 class="text-3xl md:text-4xl font-semibold text-foreground">
          {post.data.title}
        </h1>
        <div class="mt-3 flex items-center gap-3 text-sm">
          <Badge tone="primary-accent" appearance="soft" size="sm">{project.name}</Badge>
          <span class="text-muted-foreground"><FormattedDate date={post.data.date} /></span>
        </div>
      </header>

      {
        post.data.cover && (
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            class="animate mb-8 rounded-sm w-full"
          />
        )
      }

      <Prose class="animate">
        <Content />
      </Prose>
    </article>

    <Separator class="mt-12" />
    <div class="animate mt-6 text-sm text-muted-foreground">
      <Link href="/blog" underline={false}>&larr; All posts</Link>
    </div>
  </Container>
</PageLayout>
