---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PostCard from "@components/PostCard.astro";
import { ToggleGroup, ToggleGroupItem } from "@/components/starwind/toggle-group";
import { ItemGroup, ItemSeparator } from "@/components/starwind/item";
import { BLOG } from "@consts";
import { getProject } from "@lib/projects";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Unique projects (derived from each post's top-level folder), for the filter bar.
const projectMap = new Map<string, { name: string; count: number }>();
for (const p of posts) {
  const { slug, name } = getProject(p.id);
  const entry = projectMap.get(slug);
  if (entry) entry.count++;
  else projectMap.set(slug, { name, count: 1 });
}
const projects = [...projectMap.entries()]
  .map(([slug, v]) => ({ slug, ...v }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-foreground">
      Blog
    </h4>

    <ToggleGroup
      id="post-filter"
      variant="outline"
      size="sm"
      class="animate mt-6 flex-wrap"
      defaultValue={["all"]}
      aria-label="Filter posts by project"
    >
      <ToggleGroupItem value="all" class="rounded-sm data-[state=on]:bg-primary data-[state=on]:text-primary-foreground data-[state=on]:hover:bg-primary data-[state=on]:hover:text-primary-foreground">
        All <span class="opacity-60">({posts.length})</span>
      </ToggleGroupItem>
      {
        projects.map((project) => (
          <ToggleGroupItem value={project.slug} class="rounded-sm data-[state=on]:bg-primary data-[state=on]:text-primary-foreground data-[state=on]:hover:bg-primary data-[state=on]:hover:text-primary-foreground">
            {project.name} <span class="opacity-60">({project.count})</span>
          </ToggleGroupItem>
        ))
      }
    </ToggleGroup>

    <ItemGroup id="post-list" class="animate mt-8">
      {posts.map((post, i) => (
        <>
          {i > 0 && <ItemSeparator data-project-separator />}
          <PostCard post={post} />
        </>
      ))}
    </ItemGroup>

    <p id="empty-state" class="mt-8 hidden text-muted-foreground">No posts in this project yet.</p>
  </Container>
</PageLayout>

<script>
  // The Starwind ToggleGroup runtime owns the pressed state (data-state="on"
  // on the active item). We watch those attribute changes and filter the list
  // to match; an empty selection falls back to "all".
  function setupFilter() {
    const group = document.getElementById("post-filter");
    const posts = document.querySelectorAll<HTMLElement>("#post-list [data-project]");
    const empty = document.getElementById("empty-state");
    if (!group) return;

    function apply() {
      const active = group!.querySelector<HTMLElement>('[data-sw-toggle][data-state="on"]');
      const filter = active?.dataset.value || "all";
      let visible = 0;
      posts.forEach((post) => {
        const match = filter === "all" || post.dataset.project === filter;
        post.classList.toggle("hidden", !match);
        // Show the separator directly above this post only when it is visible
        // and not the first visible post, so hidden posts never leave stacked
        // or leading separators behind.
        const sep = post.previousElementSibling;
        if (sep instanceof HTMLElement && sep.hasAttribute("data-project-separator")) {
          sep.classList.toggle("hidden", !match || visible === 0);
        }
        if (match) visible++;
      });
      empty?.classList.toggle("hidden", visible > 0);
    }

    const observer = new MutationObserver(apply);
    observer.observe(group, { subtree: true, attributes: true, attributeFilter: ["data-state"] });
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });

    apply();
  }

  setupFilter();
  document.addEventListener("astro:after-swap", setupFilter);
</script>
