---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PostCard from "@components/PostCard.astro";
import { BLOG } from "@consts";
import { getProject } from "@lib/projects";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Unique projects (derived from each post's top-level folder), for the filter bar.
const projectMap = new Map<string, { name: string; count: number }>();
for (const p of posts) {
  const { slug, name } = getProject(p.id);
  const entry = projectMap.get(slug);
  if (entry) entry.count++;
  else projectMap.set(slug, { name, count: 1 });
}
const projects = [...projectMap.entries()]
  .map(([slug, v]) => ({ slug, ...v }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-[#353535] dark:text-[#FFFFFF]">
      Blog
    </h4>

    <div class="animate mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter posts by project">
      <button
        type="button"
        data-filter="all"
        class="filter-btn rounded-full border border-current/20 px-3 py-1 text-sm transition-colors"
        aria-pressed="true"
      >
        All <span class="opacity-60">({posts.length})</span>
      </button>
      {
        projects.map((project) => (
          <button
            type="button"
            data-filter={project.slug}
            class="filter-btn rounded-full border border-current/20 px-3 py-1 text-sm transition-colors"
            aria-pressed="false"
          >
            {project.name} <span class="opacity-60">({project.count})</span>
          </button>
        ))
      }
    </div>

    <div id="post-list" class="animate mt-8">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <p id="empty-state" class="mt-8 hidden opacity-70">No posts in this project yet.</p>
  </Container>
</PageLayout>

<script>
  function setupFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const posts = document.querySelectorAll<HTMLElement>("#post-list [data-project]");
    const empty = document.getElementById("empty-state");

    function apply(filter: string) {
      let visible = 0;
      posts.forEach((post) => {
        const match = filter === "all" || post.dataset.project === filter;
        post.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      buttons.forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.dataset.filter === filter));
      });
      empty?.classList.toggle("hidden", visible > 0);
    }

    buttons.forEach((btn) =>
      btn.addEventListener("click", () => apply(btn.dataset.filter || "all"))
    );

    apply("all");
  }

  setupFilter();
  document.addEventListener("astro:after-swap", setupFilter);
</script>
