---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { Button } from "@/components/starwind/button";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <Button href="/" variant="ghost" size="sm" class="text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground">Home</Button>
        <Button href="/projects" variant="ghost" size="sm" class="text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground">Projects</Button>
        <Button href="/blog" variant="ghost" size="sm" class="text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground">Blog</Button>
        <Button
          href="/Miles_Liu_2026_Resume.pdf"
          target="_blank"
          variant="ghost"
          size="sm"
          class="text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground"
          data-goatcounter-click="resume-download"
          data-goatcounter-title="Resume PDF download"
        >Resume</Button>
      </nav>
    </div>
  </Container>
</header>
