---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Item, ItemMedia, ItemContent, ItemTitle, ItemDescription } from "@/components/starwind/item";
import { projectHref, isExternalHref } from "@lib/utils";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className = "" } = Astro.props;
const href = projectHref(project.id, project.data.link);
const external = isExternalHref(href);
---

<Item
  as="a"
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  class={`group text-base ${className}`}
>
  <ItemMedia variant="image" class="h-24 w-36 self-center rounded-sm sm:h-28 sm:w-48">
    <Image
      src={project.data.thumbnail}
      alt={project.data.thumbnailAlt ?? project.data.title}
      width={480}
    />
  </ItemMedia>
  <ItemContent>
    <ItemTitle class="text-primary dark:text-foreground group-hover:text-primary-accent dark:group-hover:text-primary-accent transition-colors">
      {project.data.title}
    </ItemTitle>
    <ItemDescription class="text-sm">{project.data.description}</ItemDescription>
  </ItemContent>
</Item>
