---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-block text-current hover:opacity-70 transition-opacity duration-300 ease-in-out",
    underline && "underline underline-offset-2 decoration-current/40"
  )}
  {...rest}>
  <slot/>
</a>
