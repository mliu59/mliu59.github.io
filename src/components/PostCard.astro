---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import { Item, ItemContent, ItemTitle, ItemActions } from "@/components/starwind/item";
import { Badge } from "@/components/starwind/badge";
import { postPath } from "@lib/utils";
import { getProject } from "@lib/projects";

interface Props {
  post: CollectionEntry<"blog">;
  showProject?: boolean;
  class?: string;
}

const { post, showProject = true, class: className = "" } = Astro.props;
const project = getProject(post.id);
---

<Item
  as="a"
  href={postPath(post.id)}
  data-project={project.slug}
  size="sm"
  class={`group text-base ${className}`}
>
  <ItemContent>
    <ItemTitle class="text-primary dark:text-foreground group-hover:text-primary-accent dark:group-hover:text-primary-accent transition-colors">
      {post.data.title}
    </ItemTitle>
    {showProject && (
      <div class="flex flex-wrap gap-1.5">
        <Badge tone="primary-accent" appearance="soft" size="sm">{project.name}</Badge>
      </div>
    )}
  </ItemContent>
  <ItemActions class="self-start">
    <span class="text-sm text-muted-foreground tabular-nums whitespace-nowrap">
      <FormattedDate date={post.data.date} />
    </span>
  </ItemActions>
</Item>
