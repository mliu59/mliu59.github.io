---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Carousel, CarouselContent, CarouselItem } from "@/components/starwind/carousel";
import { Button } from "@/components/starwind/button";
import ChevronLeft from "@tabler/icons/outline/chevron-left.svg";
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";
import { projectHref, isExternalHref } from "@lib/utils";

// Looping project gallery built on the Starwind Carousel (Embla underneath).
// Three cards are visible at once on desktop with the centred one in focus;
// the ring wraps around in both directions and auto-advances via Embla's
// Autoplay plugin (paused on hover, disabled for reduced-motion users).
//
// Embla can only loop when the slides overflow the viewport, so with fewer
// than six projects the list is repeated until there are at least six slides.
// Dots and the active state map each slide back to its real project index.
interface Props {
  projects: CollectionEntry<"projects">[];
  intervalMs?: number;
}

const { projects, intervalMs = 5000 } = Astro.props;
const n = projects.length;
const MIN_SLIDES = 6;
const repeats = n > 0 ? Math.max(1, Math.ceil(MIN_SLIDES / n)) : 0;
const slides = Array.from({ length: n * repeats }, (_, i) => ({
  project: projects[i % n],
  index: i % n,
}));
---

<div class="project-carousel" data-count={n} data-interval={intervalMs}>
  <Carousel
    autoInit={false}
    opts={{ loop: true, align: "center" }}
    aria-label="Featured projects"
  >
    <CarouselContent class="-ml-4">
      {
        slides.map(({ project, index }) => {
          const href = projectHref(project.id, project.data.link);
          const external = isExternalHref(href);
          return (
            <CarouselItem class="basis-[72%] pl-4 md:basis-1/3" data-project-index={index}>
              <a
                href={href}
                target={external ? "_blank" : "_self"}
                rel={external ? "noopener noreferrer" : undefined}
                class="carousel-card group block transition-[transform,opacity] duration-500 ease-out"
                aria-label={`${project.data.title}: ${project.data.description}`}
              >
                <div class="overflow-hidden rounded-sm bg-muted ring-1 ring-border">
                  <Image
                    src={project.data.thumbnail}
                    alt={project.data.thumbnailAlt ?? project.data.title}
                    width={640}
                    class="aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  />
                </div>
                <div class="mt-3 text-center">
                  <span class="font-semibold text-primary dark:text-foreground">
                    {project.data.title}
                  </span>
                  <p class="mt-1 text-sm leading-snug text-muted-foreground">
                    {project.data.description}
                  </p>
                </div>
              </a>
            </CarouselItem>
          );
        })
      }
    </CarouselContent>

    {
      n > 1 && (
        <div class="mt-3 flex items-center justify-between">
          <div class="flex gap-2" role="tablist" aria-label="Choose project">
            {projects.map((project, i) => (
              <button
                type="button"
                class="carousel-dot size-2 rounded-full bg-foreground opacity-30 transition-opacity hover:opacity-70 aria-[current=true]:opacity-100"
                data-index={i}
                aria-label={`Go to ${project.data.title}`}
              />
            ))}
          </div>
          <div class="flex gap-2">
            <Button variant="outline" size="icon-sm" class="rounded-full" aria-label="Previous project" data-sw-carousel-previous>
              <ChevronLeft aria-hidden="true" />
            </Button>
            <Button variant="outline" size="icon-sm" class="rounded-full" aria-label="Next project" data-sw-carousel-next>
              <ChevronRight aria-hidden="true" />
            </Button>
          </div>
        </div>
      )
    }
  </Carousel>
</div>

<style>
  /* Side cards sit back; the selected (centred) card comes forward. */
  .carousel-card {
    transform: scale(0.88);
    opacity: 0.55;
  }
  [data-sw-carousel-item][data-active] .carousel-card {
    transform: scale(1);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-card {
      transition: none;
    }
  }
</style>

<script>
  import { createCarousel } from "@starwind-ui/runtime/carousel";
  import type { CarouselInstance } from "@starwind-ui/runtime/carousel";
  import Autoplay from "embla-carousel-autoplay";

  const instances = new Map<HTMLElement, CarouselInstance>();

  function setupProjectCarousels() {
    document.querySelectorAll<HTMLElement>(".project-carousel").forEach((root) => {
      if (instances.has(root)) return;
      const carouselRoot = root.querySelector<HTMLElement>("[data-sw-carousel]");
      if (!carouselRoot) return;

      const n = Number(root.dataset.count) || 1;
      const interval = Number(root.dataset.interval) || 5000;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const plugins =
        reduceMotion || n < 2
          ? []
          : [Autoplay({ delay: interval, stopOnInteraction: false, stopOnMouseEnter: true })];

      const carousel = createCarousel(carouselRoot, {
        opts: { loop: true, align: "center" },
        plugins,
      });
      instances.set(root, carousel);
      const api = carousel.api;

      const slides = [...carouselRoot.querySelectorAll<HTMLElement>("[data-sw-carousel-item]")];
      const dots = [...root.querySelectorAll<HTMLButtonElement>(".carousel-dot")];

      const update = () => {
        const selected = api.selectedScrollSnap();
        slides.forEach((slide, i) => slide.toggleAttribute("data-active", i === selected));
        const active = selected % n;
        dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === active)));
      };
      api.on("select", update);
      api.on("reInit", update);
      update();

      // Jump to the copy of a project nearest the current position.
      const nearestSlideFor = (projectIndex: number) => {
        const current = api.selectedScrollSnap();
        let best = projectIndex;
        let bestDist = Infinity;
        slides.forEach((_, i) => {
          if (i % n !== projectIndex) return;
          const d = Math.abs(i - current);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        return best;
      };

      dots.forEach((dot) =>
        dot.addEventListener("click", () => api.scrollTo(nearestSlideFor(Number(dot.dataset.index))))
      );

      // Side cards centre themselves on click; only the centred card navigates.
      slides.forEach((slide, i) => {
        slide.querySelector("a")?.addEventListener("click", (e) => {
          if (!slide.hasAttribute("data-active")) {
            e.preventDefault();
            api.scrollTo(i);
          }
        });
      });
    });
  }

  function teardownProjectCarousels() {
    instances.forEach((carousel) => carousel.destroy());
    instances.clear();
  }

  setupProjectCarousels();
  document.addEventListener("astro:before-swap", teardownProjectCarousels);
  document.addEventListener("astro:after-swap", setupProjectCarousels);
</script>
